{
"manifest_version": 3,
"name": "Slop Detector",
"version": "1.0.0",
"description": "Checks for the 'ai generated' label and proprely warns the user",

"content_scripts":[
  {
    "matches": ["*://modrinth.com/*"],
      "js": ["content.js"],
      "css": ["warning.css"],
      "run_at": "document_idle"
  }
],
"web_accessible_resources": [
  {
    "resources": ["warningsymbol.png"],
    "matches": ["*://modrinth.com/*"]
  }
]
}
